<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Paso 5 de 5 — Resumen" styleClass="step-caption"/>
    <Label text="Confirma tu Personaje" styleClass="detail-name" wrapText="true" maxWidth="Infinity"/>

    <TextArea fx:id="summaryArea" editable="false" wrapText="true" prefHeight="220" styleClass="summary-box"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="← Atrás" onAction="#onBack"/>
        <Button text="Crear Personaje ✓" onAction="#onConfirm"/>
    </HBox>
</VBox>