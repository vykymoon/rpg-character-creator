<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <Canvas fx:id="canvas" width="640" height="480"/>
    <Button text="Volver" onAction="#onBack" StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets top="10" left="10"/>
        </StackPane.margin>
    </Button>
</StackPane>