<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Paso 1 de 5 — Nombre y Raza" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
    <Label text="Crea tu Personaje" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Nombre del personaje:"/>
    <TextField fx:id="nameField" promptText="Ej: Aldric"/>

    <Label text="Raza:"/>
    <ComboBox fx:id="raceCombo" maxWidth="Infinity" promptText="Elige una raza"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Siguiente →" onAction="#onNext"/>
    </HBox>
</VBox>