<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" alignment="TOP_LEFT" styleClass="screen"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="PASO 1 DE 5 — NOMBRE Y RAZA" styleClass="step-caption"/>
    <ProgressBar progress="0.2" maxWidth="Infinity" styleClass="step-progress"/>
    <Label text="Crea tu Personaje" styleClass="title"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Formulario -->
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS" minWidth="260">
            <Label text="NOMBRE DEL PERSONAJE" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="Ej: Aldric"/>

            <Label text="RAZA" styleClass="field-label"/>
            <ComboBox fx:id="raceCombo" maxWidth="Infinity" promptText="Elige una raza"/>

            <Label text="Cada raza cambia tus atributos base. Mira la vista previa a la derecha."
                   styleClass="hint" wrapText="true"/>
        </VBox>

        <!-- Vista previa de la raza elegida -->
        <VBox spacing="10" alignment="TOP_CENTER" styleClass="card" prefWidth="230" minWidth="230">
            <Label text="VISTA PREVIA" styleClass="card-title"/>
            <ImageView fx:id="racePreview" fitWidth="130" fitHeight="130" preserveRatio="true"
                       styleClass="preview-avatar"/>
            <Label fx:id="raceDescLabel" styleClass="card-text" wrapText="true"
                   text="Elige una raza para ver sus rasgos."/>
            <Label fx:id="raceStatsLabel" styleClass="card-text"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="← Menú principal" onAction="#onBackToMenu"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Siguiente →" onAction="#onNext" styleClass="button-primary"/>
    </HBox>
</VBox>
