<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Paso 4 de 5 — Vestuario" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
    <Label text="Elige Vestuario" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="hintLabel" wrapText="true" text="Selección múltiple (opcional). Ctrl+click para elegir varias." style="-fx-font-size: 11px; -fx-text-fill: gray;"/>

    <ListView fx:id="outfitsList" VBox.vgrow="ALWAYS" prefHeight="300"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="← Atrás" onAction="#onBack"/>
        <Button text="Siguiente →" onAction="#onNext"/>
    </HBox>
</VBox>