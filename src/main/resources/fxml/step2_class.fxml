<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Paso 2 de 5 — Clase" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
    <Label text="Elige tu Clase" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Clase:"/>
    <ComboBox fx:id="classCombo" maxWidth="Infinity" promptText="Elige una clase"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="← Atrás" onAction="#onBack"/>
        <Button text="Siguiente →" onAction="#onNext"/>
    </HBox>
</VBox>