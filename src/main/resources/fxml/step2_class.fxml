<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" alignment="TOP_LEFT" styleClass="screen"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="PASO 2 DE 5 — CLASE" styleClass="step-caption"/>
    <ProgressBar progress="0.4" maxWidth="Infinity" styleClass="step-progress"/>
    <Label text="Elige tu Clase" styleClass="title"/>

    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="CLASE" styleClass="field-label"/>
        <ComboBox fx:id="classCombo" maxWidth="Infinity" promptText="Elige una clase"/>

        <Label fx:id="classDescLabel" styleClass="card-text" wrapText="true"
               text="Elige una clase para ver qué aporta a tu personaje."/>
        <Label fx:id="classBonusLabel" styleClass="card-text"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Atrás" onAction="#onBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Siguiente →" onAction="#onNext" styleClass="button-primary"/>
    </HBox>
</VBox>
