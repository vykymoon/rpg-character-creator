<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" alignment="TOP_LEFT" styleClass="screen"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="PASO 3 DE 5 — HABILIDADES" styleClass="step-caption"/>
    <ProgressBar progress="0.6" maxWidth="Infinity" styleClass="step-progress"/>
    <Label text="Elige Habilidades" styleClass="title"/>
    <Label fx:id="hintLabel" wrapText="true" styleClass="hint"
           text="Selección múltiple (opcional). Ctrl+click para elegir varias."/>

    <ListView fx:id="skillsList" VBox.vgrow="ALWAYS" prefHeight="220"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Atrás" onAction="#onBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Siguiente →" onAction="#onNext" styleClass="button-primary"/>
    </HBox>
</VBox>
