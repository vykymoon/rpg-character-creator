<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" alignment="CENTER" styleClass="battle-root"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="24" right="40" bottom="24" left="40"/>
    </padding>

    <Label text="¡Un enemigo apareció!" styleClass="battle-title"/>

    <ImageView fx:id="enemyImage" fitHeight="180" preserveRatio="true" smooth="false"
               styleClass="battle-enemy-image"/>
    <Label fx:id="enemyLabel" styleClass="battle-enemy"/>

    <HBox spacing="14" alignment="CENTER">
        <Button text="Combatir" onAction="#onFight" styleClass="button-primary"/>
        <Button text="Huir" onAction="#onFlee" styleClass="button-danger"/>
    </HBox>
</VBox>
