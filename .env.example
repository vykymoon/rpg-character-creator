# Copie este archivo como .env antes de "docker compose up":
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# Los nombres son los mismos de docs/implementacion.md (seccion 4).

# Puerto HTTP + WebSocket del servidor (en Render lo inyecta la plataforma).
PORT=8887

# Codigo de sala que deben escribir los jugadores para unirse.
# Vacio = sala abierta (modo LAN). En produccion use un valor aleatorio:
#   openssl rand -hex 12
JOIN_CODE=cambie-este-codigo

# Jugadores simultaneos. 32 es el ultimo punto sano de las pruebas de carga.
MAX_PLAYERS=32

# Mensajes por segundo y conexion antes de descartar (proteccion contra flood).
MAX_MESSAGES_PER_SECOND=20

# Tamano maximo de un mensaje WebSocket, en bytes.
MAX_MESSAGE_BYTES=4096

# Version que reporta /health. El pipeline la fija con el SHA del commit.
APP_VERSION=local

